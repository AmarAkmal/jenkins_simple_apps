pipeline {
    agent {
        docker {
            image 'python:3.11-slim'
            args '-e HOME=/tmp'
        }
    }

    triggers {
        githubPush()
    }
    stages {
        stage('Install Dependencies') {
            steps {
                dir('simple-python-app') {
                    sh 'pip install --default-timeout=120 --retries 5 -r requirements.txt'
                }
            }
        }

        stage('Run Calculator Tests') {
            steps {
                dir('simple-python-app') {
                    sh 'python -m pytest test_calculator.py --junitxml=results-calculator.xml --verbose 2>&1 | tee -a build.log'
                }
            }
        }

        stage('Run API Tests') {
            steps {
                dir('simple-python-app') {
                    sh 'python -m pytest test_api.py --junitxml=results-api.xml --verbose 2>&1 | tee -a build.log'
                }
            }
        }
    }

    post {
        always {
            junit '**/results-*.xml'
        }
        success {
            withCredentials([
                string(credentialsId: 'TELEGRAM_BOT_TOKEN', variable: 'BOT_TOKEN'),
                string(credentialsId: 'TELEGRAM_CHAT_ID', variable: 'CHAT_ID')
            ]) {
                dir('simple-python-app') {
                    sh "GIT_AUTHOR_NAME=\$(git log -1 --format='%an' 2>/dev/null || echo unknown) BUILD_DURATION='\${currentBuild.duration}' python notify.py success"
                }
            }
            echo 'All tests passed!'
        }
        failure {
            withCredentials([
                string(credentialsId: 'TELEGRAM_BOT_TOKEN', variable: 'BOT_TOKEN'),
                string(credentialsId: 'TELEGRAM_CHAT_ID', variable: 'CHAT_ID')
            ]) {
                dir('simple-python-app') {
                    sh "GIT_AUTHOR_NAME=\$(git log -1 --format='%an' 2>/dev/null || echo unknown) BUILD_DURATION='\${currentBuild.duration}' python notify.py failure"
                }
            }
            echo 'Some tests failed.'
        }
    }
}
