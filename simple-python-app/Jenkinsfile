pipeline {
    agent {
        docker {
            image 'python:3.11-slim'
            args '-e HOME=/tmp'
        }
    }

    stages {
        stage('Install Dependencies') {
            steps {
                dir('simple-python-app') {
                    sh 'pip install --default-timeout=120 --retries 5 -r requirements.txt'
                }
            }
        }

        stage('Run Calculator Tests') {
            steps {
                dir('simple-python-app') {
                    sh 'python -m pytest test_calculator.py --junitxml=results-calculator.xml --verbose 2>&1 | tee -a build.log'
                }
            }
        }

        stage('Run API Tests') {
            steps {
                dir('simple-python-app') {
                    sh 'python -m pytest test_api.py --junitxml=results-api.xml --verbose 2>&1 | tee -a build.log'
                }
            }
        }
    }

    post {
        always {
            junit '**/results-*.xml'
        }
        success {
            dir('simple-python-app') {
                sh 'python notify.py success'
            }
            echo 'All tests passed!'
        }
        failure {
            dir('simple-python-app') {
                sh 'python notify.py failure'
            }
            echo 'Some tests failed.'
        }
    }
}
