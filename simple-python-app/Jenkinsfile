pipeline {
    agent {
        docker {
            image 'python:3.11-slim'
            args '-e HOME=/tmp'
        }
    }

    stages {
        stage('Install Dependencies') {
            steps {
                dir('simple-python-app') {
                    sh 'pip install -r requirements.txt'
                }
            }
        }

        stage('Run Calculator Tests') {
            steps {
                dir('simple-python-app') {
                    sh 'python -m pytest test_calculator.py --junitxml=results-calculator.xml --verbose'
                }
            }
        }

        stage('Run API Tests') {
            steps {
                dir('simple-python-app') {
                    sh 'python -m pytest test_api.py --junitxml=results-api.xml --verbose'
                }
            }
        }
    }

    post {
        always {
            junit 'simple-python-app/results-*.xml'
        }
        success {
            script {
                def msg = "Jenkins: ${env.JOB_NAME} #${env.BUILD_NUMBER} passed"
                sh "python -c \"import urllib.request; import urllib.parse; d=urllib.parse.urlencode({'chat_id':'1203641879','text':'${msg}'}).encode(); urllib.request.urlopen('https://api.telegram.org/bot8738868776:AAHbKTBfFItG7ATSEd5BuR5c_M3NJZSaO7w/sendMessage', d)\""
            }
            echo 'All tests passed!'
        }
        failure {
            script {
                def msg = "Jenkins: ${env.JOB_NAME} #${env.BUILD_NUMBER} failed"
                sh "python -c \"import urllib.request; import urllib.parse; d=urllib.parse.urlencode({'chat_id':'1203641879','text':'${msg}'}).encode(); urllib.request.urlopen('https://api.telegram.org/bot8738868776:AAHbKTBfFItG7ATSEd5BuR5c_M3NJZSaO7w/sendMessage', d)\""
            }
            echo 'Some tests failed.'
        }
    }
}
